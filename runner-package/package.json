{
  "name": "@plugwright/runner",
  "version": "3.1.0-pcx.1",
  "description": "End-to-end testing framework for Paper/Spigot Minecraft plugins",
  "type": "module",
  "main": "dist/runner.js",
  "types": "dist/runner.d.ts",
  "bin": {
    "plugwright": "dist/cli.js"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepublishOnly": "npm run build",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "minecraft",
    "paper",
    "spigot",
    "testing",
    "e2e",
    "mineflayer"
  ],
  "author": "drownek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Drownek/plugwright.git",
    "directory": "runner-package"
  },
  "homepage": "https://github.com/Drownek/plugwright#readme",
  "bugs": {
    "url": "https://github.com/Drownek/plugwright/issues"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "mineflayer": "github:PCX-Network/mineflayer#50a2c7962aa3558f390b31e46a02f6bf1f9c84ca",
    "picocolors": "^1.1.1",
    "prismarine-auth": "^3.1.1",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/source-map-support": "^0.5.10",
    "rimraf": "^6.1.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "minecraft-data": "github:PCX-Network/minecraft-data#bbffdeb97c98d1725787a50fbdae8bca3eabd507",
    "minecraft-protocol": "github:PCX-Network/node-minecraft-protocol#fa7983cdbc26f8320392d55e1c86e680ba10595c",
    "prismarine-chunk": "github:DallasCarraher/prismarine-chunk#7382b4fef1c56290524665e7b9af58b7d1f34791"
  }
}
